{
  "name": "nofilter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "verify": "tsx tools/verify/run.ts",
    "verify:tokens": "tsx tools/verify/run.ts --only=tokens",
    "verify:motion": "tsx tools/verify/run.ts --only=motion",
    "verify:visual": "tsx tools/verify/run.ts --only=visual",
    "verify:budget": "tsx tools/verify/run.ts --only=budget",
    "brand:assets": "node scripts/brand-assets.mjs"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "gsap": "^3.13.0",
    "lenis": "^1.1.20",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.23",
    "playwright": "^1.49.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
