# deps / build
node_modules/
.next/
out/
dist/
*.tsbuildinfo

# env
.env*
!.env.example

# os / editor
.DS_Store
Thumbs.db
*.log

# Playwright MCP scratch — page snapshots and console dumps from driving the
# dev server by hand. Nothing here is evidence; verify writes that itself.
.playwright-mcp/

# verification output (regenerated; evidence reports are committed explicitly)
tools/verify/.cache/
tools/verify/output/**/*.png
# the contact sheet only means anything next to its screenshots, and those are
# not committed — regenerate it with `npm run verify:visual`
tools/verify/output/contact-sheet.html
!tools/verify/output/**/report.md

# Stray captures at the repo root. The Playwright MCP tools default to writing
# a screenshot into the working directory, and driving the dev server by hand
# leaves a trail of them. Named shots that are meant to survive go to
# docs/screenshots/ via `npm run readme:shots`, and temporary ones belong in a
# scratchpad outside the repo.
/*.png
/fullpage screenshot.png

# ── reference material dropped in by hand ───────────────────────────────
# Screenshots and clips Sayandeep drops at the repo root while reviewing —
# the electric-pole reel that became the wire rig (D-056), and whatever
# follows it. They are somebody else's frames, they are phone screenshots
# rather than assets, and the *decisions* they produced are written down in
# docs/build/. Keep the folder locally for as long as it is useful.
/electric pole wire connections/
/reference/

# ── tonik-owned material ────────────────────────────────────────────────
# Recovered from tonik.com for analysis. Kept LOCAL ONLY — this repo is
# public and these are their assets, not ours. The extracted *values* live
# in docs/spec/, which is our own work and is committed.
docs/research/source/tonik-animations.js
docs/research/source/tonik-ix2.json
docs/research/source/tonik-hero-scene.splinecode
docs/research/source/ix2-hover.txt

# The tonik extract's raw JSON. The readable summary in
# docs/research/03-tonik-extract.md is what the build reads and is committed;
# the dumps are large, regenerable with `npm run extract:tonik`, and are their
# measurements rather than ours.
tools/extract/output/
